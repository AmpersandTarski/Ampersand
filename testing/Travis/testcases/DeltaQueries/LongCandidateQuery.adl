CONTEXT LongCandidateQuery IN ENGLISH
-- The script of issue #1728. See README.md in this directory.
RELATION same[Req*Req]
RELATION busy[Req*Req] [PROP]
RELATION sector[Req*Sector]
RELATION except[Req*Organism]
RELATION begin[Req*Date] [UNI]
RELATION end[Req*Date] [UNI]
RELATION equal[Req*Req]
ENFORCE equal :=
   (((( same
   - (same /\ sector;((sector~;same) - sector~)))
   - (same /\ sector;((sector~;same) - sector~))~)
   - (same /\ except;((except~;same) - except~)))
   - (same /\ except;((except~;same) - except~))~)
   - (((I[Req] /\ begin;begin~);same) - (same /\ begin;begin~))

-- A population, so that `ampersand validate` compares the SQL of every term with its meaning.
POPULATION same[Req*Req] CONTAINS
  [ ("r1","r1"), ("r1","r2"), ("r2","r1"), ("r2","r2"), ("r1","r3"), ("r3","r1")
  , ("r3","r3"), ("r4","r5"), ("r5","r4"), ("r4","r4"), ("r5","r5"), ("r2","r6")
  , ("r6","r2"), ("r6","r6"), ("r3","r4") ]
POPULATION sector[Req*Sector] CONTAINS
  [ ("r1","meat"), ("r2","meat"), ("r3","meat"), ("r3","fish"), ("r4","fish")
  , ("r5","fish"), ("r6","dairy") ]
POPULATION except[Req*Organism] CONTAINS
  [ ("r1","salmonella"), ("r2","salmonella"), ("r4","listeria"), ("r6","listeria") ]
POPULATION begin[Req*Date] CONTAINS
  [ ("r1","2026-01-01"), ("r2","2026-01-01"), ("r3","2026-02-01"), ("r4","2026-03-01")
  , ("r5","2026-03-01") ]
POPULATION end[Req*Date] CONTAINS
  [ ("r1","2026-12-31"), ("r4","2026-12-31") ]
ENDCONTEXT
