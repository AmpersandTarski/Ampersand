CONTEXT Migration IN ENGLISH
-- The counterpart of violation_repaired: b1 has an author, but fixedAuthored does not register it.
-- Then the transactional invariant of step 4 (eqn:enforceForRules) is not satisfied,
-- and a user could remove the author of b1 again without the blocking invariant refusing it.
INCLUDE "../scripts/library_migration.adl"

POPULATION new.title[new.Book*new.Title] CONTAINS [ ("b1", "Emma") ; ("b2", "Ivanhoe") ]
POPULATION copyTitle[old.Book*old.Title] CONTAINS [ ("b1", "Emma") ; ("b2", "Ivanhoe") ]
POPULATION new.author[new.Book*new.Writer] CONTAINS [ ("b1", "Austen") ]

RULE fixedRegistersRepairs : I[new.Book] /\ new.author;new.author~ |- fixedAuthored

ENDCONTEXT
