CONTEXT Cleanup INCLUDES Orders FROM "../contexts/orders.adl"
CONTEXT Cleanup IN ENGLISH
-- The context relaxes an invariant of Orders, so order o2 may be without a customer.
-- The compiler adds the relation fixedHasCustomer, for the orders that satisfy the rule,
-- and a blocking invariant for the orders that are registered there.
-- This script registers o2 itself, which has no customer: the blocking invariant refuses that.
ROLE Clerk MAINTAINS Orders.hasCustomer

POPULATION Orders.customer[Orders.Order*Orders.Customer] CONTAINS [ ("o1", "Ada") ]
POPULATION Orders.Order CONTAINS [ "o2" ]
POPULATION fixedHasCustomer[Orders.Order*Orders.Order] CONTAINS [ ("o2", "o2") ]

ENDCONTEXT
